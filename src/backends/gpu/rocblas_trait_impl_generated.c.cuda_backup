                               fb_gpu_ptr_t c, int ldc) {
    rocblas_context_t* ctx = (rocblas_context_t*)handle;
    rocblas_side side_mode = (rocblas_side)rocblas_convert_side(side);
    rocblas_fill fill = (rocblas_fill)rocblas_convert_uplo(uplo);
    
    if (stream) {
        rocblas_set_stream(ctx->rocblas_handle, (hipStream_t)stream);
