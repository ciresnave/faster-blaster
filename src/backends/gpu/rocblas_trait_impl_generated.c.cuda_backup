static float rocblas_sdot_impl(void* handle, fb_gpu_stream_t stream,
                               int n, fb_gpu_ptr_t x, int incx,
                               fb_gpu_ptr_t y, int incy) {
    rocblas_context_t* ctx = (rocblas_context_t*)handle;
    float result = 0.0f;
    
    if (stream) {
        rocblas_set_stream(ctx->rocblas_handle, (hipStream_t)stream);
    }
    
    rocblas_sdot(ctx->rocblas_handle, n, (const float*)x, incx, (const float*)y, incy, &result);
    return result;
}

