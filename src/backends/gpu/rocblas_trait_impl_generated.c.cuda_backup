        rocblas_set_stream(ctx->rocblas_handle, (hipStream_t)stream);
    }
    
    rocblas_idamax(ctx->rocblas_handle, n, (const double*)x, incx, &result);
    return result - 1; // cuBLAS returns 1-based index, convert to 0-based
}

