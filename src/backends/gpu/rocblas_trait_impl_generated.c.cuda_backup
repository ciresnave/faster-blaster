static void rocblas_zdotc_impl(void* handle, fb_gpu_stream_t stream,
                               int n, fb_gpu_ptr_t x, int incx,
                               fb_gpu_ptr_t y, int incy, void* result) {
    rocblas_context_t* ctx = (rocblas_context_t*)handle;
    
