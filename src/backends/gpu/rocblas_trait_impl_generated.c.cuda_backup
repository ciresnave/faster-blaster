                               fb_gpu_ptr_t y, int incy) {
    rocblas_context_t* ctx = (rocblas_context_t*)handle;
    rocblas_operation op = (rocblas_operation)rocblas_convert_transpose(trans);
    
    if (stream) {
        rocblas_set_stream(ctx->rocblas_handle, (hipStream_t)stream);
    }
    
    rocblas_sgemv(ctx->rocblas_handle, op, m, n, &alpha,
                (const float*)a, lda, (const float*)x, incx,
                &beta, (float*)y, incy);
