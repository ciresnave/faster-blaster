    char *uplo, char *trans, char *diag, char *normin, int *n, int *kd,        \
    TYPE *ab, int *ldab, TYPE *x, TYPE *scale, TYPE *cnorm, int *info) {       \
  if (!g_cblas_fn[OP_ID]) {                                                    \
    if (info) *info = -1;                                                      \
    return;                                                                    \
