DEFINE_LAPACK_HESSENBERG_REDUCTION_NWORK_THUNKS(dgehd2, double, FB_OP_DGEHD2)
DEFINE_LAPACK_HESSENBERG_REDUCTION_NWORK_THUNKS(cgehd2, fb_complex_float_t,
