    char *uplo, int *n, MAT_TYPE *ap, int *ipiv, REAL_TYPE *anorm,             \
    REAL_TYPE *rcond, MAT_TYPE *work, REAL_TYPE *rwork, int *info) {           \
  fb_uplo_t uplo_ = FB_UPPER;                                                   \
