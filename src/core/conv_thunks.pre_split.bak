  rwork = (RTYPE *)malloc((size_t)rwork_size * sizeof(RTYPE));                 \
  if (!work || !rwork) {                                                       \
    free(work);                                                                \
    free(rwork);                                                               \
    return -101;                                                               \
  }                                                                            \
  ((void (*)(char *, char *, int *, int *, CTYPE *, int *, RTYPE *, CTYPE *,  \
