    if (info) *info = -1;                                                      \
    return;                                                                    \
  }                                                                            \
  int rc =                                                                     \
      ((int (*)(fb_layout_t, int, int, int, int, MAT_TYPE *, int, int *,      \
                MAT_TYPE *, int))g_cblas_fn[OP_ID])(                          \
