    *info = -1;                                                                \
    return;                                                                    \
  }                                                                            \
  if ((*n > 0 && !t) || (*wantq != 0 && *n > 0 && !q) || (*n > 0 && !work)) { \
    *info = -1;                                                                \
    return;                                                                    \
  }                                                                            \
  info_ = ((int (*)(int, int, TYPE *, int, TYPE *, int, int, int, int, TYPE *))\
               g_cblas_fn[OP_ID])(*wantq, *n, t, *ldt, q, *ldq, *j1, *n1,      \
                                  *n2, work);                                  \
  *info = info_;                                                               \
}

