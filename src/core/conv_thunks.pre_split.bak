static void thunk_##OP##_cblas_to_fortran(                                      \
    char *fact, char *uplo, int *n, int *kd, int *nrhs, MAT_TYPE *ab,          \
    int *ldab, MAT_TYPE *afb, int *ldafb, char *equed, REAL_TYPE *s,           \
