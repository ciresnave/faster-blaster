  }                                                                             \
  tau_ = *tau;                                                                  \
  *info = ((int (*)(fb_layout_t, char, int, int, const TYPE *, TYPE, TYPE *,   \
                    int, TYPE *))g_cblas_fn[OP_ID])(                            \
      FB_LAYOUT_COL_MAJOR, *side, *m, *n, v, tau_, c, *ldc, work);             \
