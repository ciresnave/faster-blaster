                  TYPE *, int, TYPE *, int, TYPE *, int))g_cblas_fn[OP_ID])(  \
      *side, *trans, *direct, *storev, *m, *n, *k, *l, v, *ldv,               \
      t, *ldt, c, *ldc, work, *ldwork);                                        \
}

