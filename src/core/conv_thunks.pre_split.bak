      (MAT_TYPE *)ef, (MAT_TYPE *)b_arg, &ldb_, (MAT_TYPE *)x_arg, &ldx_,      \
      ferr, berr, work, rwork, &info);                                          \
  free(b_col);                                                                  \
  free(x_col);                                                                  \
  free(work);                                                                   \
  free(rwork);                                                                  \
  return info;                                                                  \
}                                                                               \
static void thunk_##OP##_cblas_to_fortran(                                      \
    char *uplo, int *n, int *nrhs, REAL_TYPE *d, MAT_TYPE *e, REAL_TYPE *df,   \
