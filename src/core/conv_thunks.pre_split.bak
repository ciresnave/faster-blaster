      !scale || !cnorm || !info) {                                             \
    if (info) *info = -1;                                                      \
    return;                                                                    \
  }                                                                            \
  *info = ((int (*)(fb_layout_t, char, char, char, char, int, int, TYPE *,    \
                    int, TYPE *, TYPE *, TYPE *))g_cblas_fn[OP_ID])(           \
      FB_LAYOUT_COL_MAJOR, *uplo, *trans, *diag, *normin, *n, *kd, ab, *ldab, \
      x, scale, cnorm);                                                        \
}

