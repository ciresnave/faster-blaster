    const int *n, const void *alpha, const void *x,                             \
    const int *incx, void *y, const int *incy) {                                \
    if (!g_cblas_fn[OP_ID]) return;                                             \
    ((void(*)(int, const void*, const void*, int, void*, int))                  \
     g_cblas_fn[OP_ID])(*n, alpha, x, *incx, y, *incy);                        \
}

