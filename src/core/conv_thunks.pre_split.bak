      &ldc_, &work_query, &lwork_, &info);                                      \
  if (info != 0) {                                                              \
    free(a_col);                                                                \
    free(tau_copy);                                                             \
    free(c_col);                                                                \
    return info;                                                                \
  }                                                                             \
  lwork_ = QUERY_FN(work_query);                                                \
  work = (TYPE *)malloc((size_t)lwork_ * sizeof(TYPE));                         \
  if (!work) {                                                                  \
    free(a_col);                                                                \
    free(tau_copy);                                                             \
    free(c_col);                                                                \
    return -101;                                                                \
  }                                                                             \
  if ((a_rows > 0 && k > 0 &&                                                   \
       fb_copy_matrix_to_col_major(A, layout, a_rows, k, lda,                  \
                                   a_col, lda_, sizeof(TYPE)) != 0) ||         \
