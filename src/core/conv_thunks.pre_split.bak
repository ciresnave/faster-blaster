                                      b, ldb, sizeof(MAT_TYPE)) != 0) {        \
      free(b_col);                                                              \
      return -1;                                                                \
    }                                                                           \
    free(b_col);                                                                \
  }                                                                             \
  return info;                                                                  \
}                                                                               \
