    int *ijob, int *wantq, int *wantz, const int *select, int *n, void *a,
    int *lda, void *b, int *ldb, void *alpha, void *beta, void *q, int *ldq,
    void *z, int *ldz, int *m, float *pl, float *pr, float *dif, void *work,
