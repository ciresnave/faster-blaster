  ((void (*)(char *, int *, int *, TYPE *, TYPE *, TYPE *, int *, TYPE *,      \
             int *))g_fortran_fn[OP_ID])(                                       \
      &side_, &m_, &n_, (TYPE *)v, &tau_, c_col, &ldc_, work, &info);          \
